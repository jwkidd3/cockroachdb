-if crdb_run node decommission "$DECOMM_NODE" --insecure >/dev/null 2>&1; then
+DECOMM_OK=0
+for attempt in 1 2 3; do
+    if crdb_run node decommission "$DECOMM_NODE" --insecure >/dev/null 2>&1; then
+        DECOMM_OK=1
+        break
+    fi
+    warn "decommission attempt $attempt failed; node 4 may not be taking replicas yet"
+    sleep 20
+done
+if [ "$DECOMM_OK" = "1" ]; then
